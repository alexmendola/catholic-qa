---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LiteYouTube from "../../components/LiteYouTube.astro";

export async function getStaticPaths() {
  const answers = await getCollection("answers");
  return answers.map((answer) => ({
    params: { id: answer.id },  // fills in [id] in the URL
    props: { answer },          // hands this answer to the page
  }));
}

// Everything below runs once per answer.
const { answer } = Astro.props;
const { Content, headings } = await render(answer);

// Enforce the answer template: an error here stops the build.
const REQUIRED = ["Explanation", "What to say", "If they push back"];
const titles = headings.filter((h) => h.depth === 2).map((h) => h.text);
for (const required of REQUIRED) {
  if (!titles.includes(required)) {
    throw new Error(`${answer.id}.md is missing the "## ${required}" section`);
  }
}
const topic = await getEntry(answer.data.topic)
const labels = { free: "Free read", book: "Book", video: "Video" };
---

<Layout title={answer.data.title} description={answer.data.shortAnswer}>
  <main>
    <p> {topic.data.name}</p>
    <h1>{answer.data.title}</h1>

    <section aria-labelledby="short-answer" class="short-answer">
      <h2 id="short-answer">Short answer</h2>
      <p>{answer.data.shortAnswer}</p>
    </section>

    <Content />
    <h2>Sources</h2>
    <ul>{answer.data.scripture.map((ref) => <li>{ref}</li>)}</ul>
    <ul>{answer.data.catechism.map((n) => (<li><a href={`https://www.scborromeo.org/ccc/para/${n}.htm`}>CCC {n}</a></li>))}</ul>  

    {answer.data.goDeeper && (
      <section aria-labelledby="go-deeper">
        <h2 id="go-deeper">Go deeper</h2>
        <ul>
          {answer.data.goDeeper.map((item) => (
            <li>
              <span>{labels[item.type]}:</span> <a href={item.url}>{item.title}</a>
              {item.author && <span> by {item.author}</span>}
              {item.youtubeId && <LiteYouTube id={item.youtubeId} title={item.title} />}
            </li>
          ))}
        </ul>
      </section>
)}

</main>
</Layout>

<style>
    .short-answer{
        background: var(--surface);
        border-left: 4px solid var(--accent);
        border-radius: 14px;
        padding: 20px 24px;
        margin-block: 24px;
        box-shadow: 0 2px 12px rgb(0 0 0 / 0.06);
    }

    .short-answer h2 {
        margin: 0 0 4px;           /* no gap above, small gap below */
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;    /* spread capitals out a little, so they're easier to read */
        color: var(--accent);
    }

    .short-answer p {
        margin: 0;
    }

    :global(.what-to-say) {
        background: var(--accent-tint);
        border-left: 4px solid var(--accent);
        border-radius: 14px;
        padding: 20px 24px;
        margin-block: 24px;
        box-shadow: 0 2px 12px rgb(0 0 0 / 0.06);
    }
</style>